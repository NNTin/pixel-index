{
  "extends": "../../tsconfig.strict.json",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,
    // ajv is CJS. The named Ajv2020 export resolves cleanly, but ajv-formats
    // only has a default export, which needs interop to be callable.
    "esModuleInterop": true,
    // Type-checking only; tsconfig.build.json owns the emit.
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src/**/*"]
}

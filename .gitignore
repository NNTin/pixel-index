# Build output. Previews and the index are generated on every build and
# published with the site, never committed, so they cannot drift from the
# layouts or from the pinned Pixel Agents.
dist/

node_modules/

# Scratch markdown written and removed by tools/check-mermaid.test.mjs. Ignored
# so a crashed run cannot leave a deliberately-broken diagram somewhere the
# mermaid check would then pick up.
.mermaid-fixtures/

# Local deployment config
.env
.env.local
.env.*.local

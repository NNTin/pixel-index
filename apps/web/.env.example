# Copy to .env.local for local development (gitignored). Vite only exposes
# variables prefixed VITE_ to client code — everything here ends up in the
# public bundle, so never put a secret in this file.

# Where the #6 public layout API lives. No default is baked into source for
# production builds — see vite.config.ts and client.ts — but local dev
# defaults to the API service's own default port if this is unset.
VITE_API_BASE_URL=http://localhost:3000

# Only needed for a GitHub Pages PROJECT site (https://<user>.github.io/<repo>/).
# Leave unset for Vercel and local dev, which both serve from the root.
# .github/workflows/pages.yml sets this for the production Pages build — it
# defaults to /<repo-name>/ and is overridable with the PAGES_BASE_PATH
# repository variable (set that to `/` if Pages serves a custom domain).
# See docs/deployment.md, "Environment variables".
# VITE_BASE_PATH=/pixel-index/

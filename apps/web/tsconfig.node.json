{
  "extends": "../../tsconfig.strict.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "types": ["node"],
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    "erasableSyntaxOnly": true,

    // build/liveOfficeAssets.ts decodes the upstream's sprite PNGs by importing
    // vendor/pixel-agents/core/src/assets/* directly, so tsc typechecks those
    // sources too and they do not satisfy either flag. Same reasoning as
    // tsconfig.live-office.json — see the longer note there.
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false
  },
  "include": ["vite.config.ts", "vitest.config.ts", "build/**/*.ts"]
}

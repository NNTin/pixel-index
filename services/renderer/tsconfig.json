{
  "extends": "../../tsconfig.strict.json",
  "compilerOptions": {
    "target": "ES2023",
    // DOM is here for the page.evaluate() callbacks only — those run inside
    // Chromium, not in Node. Nothing outside a page.evaluate() may touch it.
    "lib": ["ES2023", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    // Type-checking only; tsconfig.build.json owns the emit.
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  // The two vitest configs are in here, not just src/**/*: they were
  // previously outside every tsconfig, so nothing checked them.
  "include": ["src/**/*", "vitest.config.ts", "vitest.integration.config.ts"],
  "exclude": ["dist"]
}

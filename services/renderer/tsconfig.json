{
  "compilerOptions": {
    "target": "ES2023",
    // DOM is here for the page.evaluate() callbacks only — those run inside
    // Chromium, not in Node. Nothing outside a page.evaluate() may touch it.
    "lib": ["ES2023", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "declaration": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src/**/*"],
  "exclude": ["dist"]
}

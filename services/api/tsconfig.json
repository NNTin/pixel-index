{
  "extends": "../../tsconfig.strict.json",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    // Type-checking only; tsconfig.build.json owns the emit.
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  // drizzle.config.ts is in here, not just src/**/*: it was previously outside
  // every tsconfig, so it was neither typechecked nor lintable. It is the file
  // that decides where migrations are generated from.
  "include": ["src/**/*", "drizzle.config.ts", "vitest.config.ts"],
  "exclude": ["dist"]
}
